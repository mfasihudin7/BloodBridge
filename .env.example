# ==============================================================================
# BloodBridge Environment Variables (.env.example)
# Copy this file to .env.local and populate the values.
# NEVER commit .env.local or any secret keys to version control.
# ==============================================================================

# Supabase (Public — safe for client-side / browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (Server-only — NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# Scheduler / Cron Secret (Server-only)
CRON_SECRET=

# OCR Provider Configuration (Optional — manual entry is supported without OCR)
OCR_PROVIDER=
OCR_API_KEY=
OCR_MODEL=
